# Copy this file to .env and fill in your real key. Never commit .env.
GEMINI_API_KEY=your_api_key_here

# Any Gemini model name you have access to (optional).
# Default: gemini-3.8-flash. Alias that always points to the newest Flash: gemini-flash-latest
GEMINI_MODEL=gemini-3.8-flash

# Where the history database is stored (optional)
DB_PATH=history.db
